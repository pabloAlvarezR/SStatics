{
  "name": "sstatics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-prisma-schema.mjs && prisma generate && next dev",
    "build": "node scripts/sync-prisma-schema.mjs && prisma generate && next build",
    "vercel-build": "node scripts/sync-prisma-schema.mjs && prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:push": "node scripts/sync-prisma-schema.mjs && prisma db push",
    "db:migrate": "node scripts/sync-prisma-schema.mjs && prisma migrate dev",
    "db:setup": "docker compose up -d && node scripts/sync-prisma-schema.mjs && prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "node scripts/sync-prisma-schema.mjs && prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@tanstack/react-query": "^5.62.8",
    "next": "^15.1.3",
    "next-auth": "^5.0.0-beta.25",
    "openid": "^2.0.12",
    "node-cron": "^3.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
