{
  "name": "sstatics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-prisma-schema.mjs && prisma generate && next dev",
    "build": "node scripts/sync-prisma-schema.mjs && prisma generate && next build",
    "vercel-build": "node scripts/sync-prisma-schema.mjs && prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native",
    "db:up": "docker compose up -d",
    "db:push": "node scripts/sync-prisma-schema.mjs && prisma db push",
    "db:migrate": "node scripts/sync-prisma-schema.mjs && prisma migrate dev",
    "db:setup": "docker compose up -d && node scripts/sync-prisma-schema.mjs && prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "node scripts/sync-prisma-schema.mjs && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.102.8",
    "next": "^15.5.25",
    "next-auth": "5.0.0-beta.32",
    "openid": "^2.0.12",
    "node-cron": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "zod": "^3.24.1",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.25",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "deepmerge-ts": "8.0.2",
    "js-yaml": "4.3.2",
    "jsdom": "30.0.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.4"
  }
}
